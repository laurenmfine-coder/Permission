+<script>
+(function () {
+  var SOURCE = 'coach-or-therapist-page';
+  var WORKSHEET = "Coach, Therapist, or Both";
+  var FILENAME = "coach-therapist-or-both.pdf";
+  var IS_IMAGE = false;
+
+  var form = document.getElementById('signupForm');
+  var submitBtn = document.getElementById('submitBtn');
+  var formStatus = document.getElementById('formStatus');
+  var doneBox = document.getElementById('doneBox');
+  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
+  var BUTTON_TEXT = submitBtn.textContent;
+  var lastUrl = null;
+
+  function setInvalid(fieldId, invalid) {
+    var el = document.getElementById(fieldId);
+    if (el) el.classList.toggle('invalid', invalid);
+  }
+  ['firstName', 'email'].forEach(function (id) {
+    document.getElementById(id).addEventListener('input', function () { setInvalid(id + 'Field', false); });
+  });
+
+  function saveBlob(url) {
+    var a = document.createElement('a');
+    a.href = url; a.download = FILENAME;
+    document.body.appendChild(a); a.click(); document.body.removeChild(a);
+  }
+
+  function fail(msg) {
+    formStatus.textContent = msg || 'Something went wrong. Please try again, or email reasondxcoaching@gmail.com.';
+    formStatus.classList.add('show');
+    submitBtn.disabled = false;
+    submitBtn.textContent = BUTTON_TEXT;
+  }
+
+  form.addEventListener('submit', function (e) {
+    e.preventDefault();
+    formStatus.classList.remove('show');
+    var firstName = document.getElementById('firstName').value.trim();
+    var email = document.getElementById('email').value.trim();
+    var valid = true;
+    if (!firstName) { setInvalid('firstNameField', true); valid = false; }
+    if (!EMAIL_RE.test(email)) { setInvalid('emailField', true); valid = false; }
+    if (!valid) {
+      var firstBad = form.querySelector('.field.invalid input');
+      if (firstBad) firstBad.focus();
+      return;
+    }
+    submitBtn.disabled = true;
+    submitBtn.textContent = 'Sending...';
+
+    var params = new URLSearchParams(window.location.search);
+    var notes = 'utm_source=' + (params.get('utm_source') || '') +
+      '; utm_medium=' + (params.get('utm_medium') || '') +
+      '; utm_campaign=' + (params.get('utm_campaign') || '') +
+      '; referrer=' + (document.referrer || '');
+
+    fetch('/api/download', {
+      method: 'POST',
+      headers: { 'Content-Type': 'application/json' },
+      body: JSON.stringify({
+        firstName: firstName,
+        email: email,
+        worksheet: WORKSHEET,
+        alsoSubstack: true,
+        source: SOURCE,
+        notes: notes,
+        company: document.getElementById('company').value
+      })
+    }).then(function (r) {
+      if (!r.ok) {
+        return r.json().catch(function () { return {}; }).then(function (body) { throw new Error(body.error || ''); });
+      }
+      return r.blob();
+    }).then(function (blob) {
+      if (typeof gtag === 'function') {
+        gtag('event', 'lead_capture', { worksheet: WORKSHEET, source: SOURCE });
+      }
+      lastUrl = window.URL.createObjectURL(blob);
+      form.style.display = 'none';
+      doneBox.classList.add('show');
+      if (IS_IMAGE) {
+        document.getElementById('resultImg').src = lastUrl;
+        document.getElementById('saveLink').href = lastUrl;
+      } else {
+        saveBlob(lastUrl);
+        var again = document.getElementById('againLink');
+        if (again) again.addEventListener('click', function (ev) { ev.preventDefault(); saveBlob(lastUrl); });
+      }
+    }).catch(function (err) { fail(err && err.message); });
+  });
+})();
+</script>
+</body>
