+  (function animRing(){rx+=(mx-rx)*0.12;ry+=(my-ry)*0.12;ring.style.transform=`translate(${rx-15}px,${ry-15}px)`;requestAnimationFrame(animRing);})();
+  document.querySelectorAll('a,button').forEach(el=>{el.addEventListener('mouseenter',()=>{cursor.classList.add('on');ring.classList.add('on');});el.addEventListener('mouseleave',()=>{cursor.classList.remove('on');ring.classList.remove('on');});});
