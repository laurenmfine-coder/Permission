+      "@type": "Question",
+      "name": "How do I make time for myself when I'm busy?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Start with a time audit to see where your hours go, then claim one hour a week and put it on your calendar like an appointment. Protect it for two weeks before you add more."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "How much time for myself do I need?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "There is no magic number. One protected hour a week is a realistic start for most busy people. Uninterrupted time matters more than total minutes, so aim for one solid block instead of scattered scraps."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "How can a working mom find time for herself?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Schedule it, trade protected time with a partner, lower the standard on one household task, and outsource what you can afford to. Build self care into the week instead of waiting for leftover time."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "Is it selfish to make time for yourself?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "No. Time for yourself is maintenance. You show up with more patience and energy for the people who depend on you when you are not running on empty."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "How do I find time for hobbies?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Start with twenty minutes, attach it to something you already do, and make it social if you can. Before you add it, decide what it replaces on your calendar."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "What is time confetti?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Time confetti is a term coined by journalist Brigid Schulte and used by Harvard Business School professor Ashley Whillans for the small bits of seconds and minutes lost to unproductive multitasking. Phones and notifications break free time into pieces that do not feel restful."
+      }
+    }
+  ]
