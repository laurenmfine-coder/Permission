+{
+  "@context": "https://schema.org",
+  "@type": "FAQPage",
+  "mainEntity": [
+    {
+      "@type": "Question",
+      "name": "How do I stop being a people pleaser?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Put a pause between the ask and your answer, name what the yes will cost, and practice short, kind noes in low-stakes situations first. Expect some guilt. It fades with practice."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "What are the signs of people pleasing?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Common signs include saying yes before you think, over-explaining when you decline, feeling responsible for other people's moods, apologizing often, and resenting the people you keep saying yes to."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "Why am I a people pleaser?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Often because it worked. Being agreeable gets rewarded at school, at work and at home. Fear of conflict, family patterns, and gender expectations also play a role."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "Is people pleasing a trauma response?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Sometimes. Psychotherapist Pete Walker describes a fawn response, where people learn to stay safe by appeasing others. It is not a formal diagnosis, and not all people pleasing comes from trauma. If saying no brings up fear for your safety or past harm, see a licensed therapist."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "How do I stop people pleasing at work?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "Use your core priorities as a filter, ask your manager which project should move to make room for a new one, suggest rotations for recurring tasks, and pause before volunteering in meetings."
+      }
+    },
+    {
+      "@type": "Question",
+      "name": "Should I see a coach or a therapist for people pleasing?",
+      "acceptedAnswer": {
+        "@type": "Answer",
+        "text": "A coach can help you change the habit and practice new responses. A therapist is the right choice if people pleasing is tied to trauma, anxiety, depression, or an unsafe relationship. Many people benefit from both."
+      }
+    }
+  ]
+}
